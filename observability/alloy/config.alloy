// Grafana Alloy (Promtail's successor): reads the app container's stdout and ships it to Loki.
// The app only prints JSON lines; it does not know Loki exists.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "app_only" {
  targets = []

  // Keep only the payments app, not Postgres or LocalStack.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "app"
    action        = "keep"
  }
}

loki.source.docker "app" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.app_only.rules
  labels        = { app = "payments-mcp" }
  forward_to    = [loki.process.json.receiver]
}

loki.process "json" {
  // Labels must have few values: level (info, warn, error) yes; requestId NO.
  // requestId is searched at query time instead: {app="payments-mcp"} | json | requestId="..."
  stage.json {
    expressions = { level = "level" }
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
