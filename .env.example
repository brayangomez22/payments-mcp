PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://payments:payments@localhost:5432/payments
PROVIDER_TIMEOUT_MS=5000

# Events (docker compose up -d localstack). Omit SQS_QUEUE_URL to disable the relay.
SQS_QUEUE_URL=http://localhost:4566/000000000000/payments-events
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
OUTBOX_POLL_MS=1000

# Agent demo (npm run demo:agent). Anthropic credentials: ANTHROPIC_API_KEY or `ant auth login`.
# ANTHROPIC_API_KEY=
# PAYMENTS_MCP_URL=http://localhost:3000/mcp
# AGENT_CLIENT_ID=tienda-a-backend      # default tienda-a-agent (cannot refund)
# AGENT_CLIENT_SECRET=dev-secret-tienda-a
# AGENT_MODEL=claude-opus-5-5
